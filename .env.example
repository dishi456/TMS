# ---- Database ----
DATABASE_URL="postgresql://tms:tms@localhost:5432/tms?schema=public"

# ---- Auth.js (NextAuth v5) ----
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="change-me-in-production"
AUTH_TRUST_HOST="true"

# ---- Web Push (VAPID) ----
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# ---- Razorpay ----
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ---- Cloudflare R2 (S3-compatible storage) ----
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="tms-files"
R2_PUBLIC_BASE_URL=""

# ---- Email (Resend) ----
RESEND_API_KEY=""
EMAIL_FROM="TMS <noreply@example.com>"

# ---- SMS (Twilio) — used for tiered rent reminders ----
# Without these, reminders still send via email + app notification (SMS logs to console).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Scheduled automation
CRON_SECRET=""

# Public base URL (for links in emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
