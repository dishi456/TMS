# ---- Database ----
DATABASE_URL="postgresql://tms:tms@localhost:5432/tms?schema=public"

# ---- Auth.js (NextAuth v5) ----
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="change-me-in-production"
AUTH_TRUST_HOST="true"
# Two-factor email OTP at login. Off by default (password-only login).
# Set to "on" to require an emailed code as a second factor.
AUTH_LOGIN_OTP="off"

# ---- Web Push (VAPID) ----
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# ---- Razorpay ----
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ---- Cloudflare R2 (S3-compatible storage) ----
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="tms-files"
R2_PUBLIC_BASE_URL=""

# ---- Email: Gmail SMTP (primary) ----
# Enable 2-Step Verification on the Gmail account, then create an App Password
# at https://myaccount.google.com/apppasswords and paste the 16-char value here.
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD=""

# ---- Email: Resend (optional fallback) ----
RESEND_API_KEY=""
EMAIL_FROM="Lease Lord <you@gmail.com>"

# ---- SMS (Twilio) — used for tiered rent reminders ----
# Without these, reminders still send via email + app notification (SMS logs to console).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Scheduled automation
CRON_SECRET=""

# Public base URL (for links in emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
