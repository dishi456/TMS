// Tenant Management System — data model derived from the SRS.
// MySQL + Prisma. Three roles share one User table; data is scoped by role.
//
// MySQL notes vs the original Postgres model:
//  - MySQL has no array type, so the former String[] fields (amenities,
//    remindersSent, images) are stored as JSON arrays.
//  - MySQL's default String maps to VARCHAR(191); free-text and URL fields are
//    marked @db.Text so long values are never truncated/rejected.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum Role {
  MASTER_ADMIN
  LANDLORD
  TENANT
  USER // public seeker: browses, saves, chats; a landlord can later convert to TENANT
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum PropertyType {
  APARTMENT
  HOUSE
  ROOM
  COMMERCIAL
  OTHER
}

enum AvailabilityStatus {
  AVAILABLE
  OCCUPIED
  UNAVAILABLE
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  RENEWED
  TERMINATED
  EXPIRED
  COMPLETED
}

enum NoticeParty {
  TENANT
  LANDLORD
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  UPI
  DEBIT_CARD
  CREDIT_CARD
  NET_BANKING
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum MaintenanceStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REJECTED
}

enum ComplaintStatus {
  OPEN
  RESPONDED
  RESOLVED
  CLOSED
  REOPENED
}

enum RatingDirection {
  LANDLORD_TO_TENANT
  TENANT_TO_LANDLORD
}

enum RatingStatus {
  VISIBLE
  FLAGGED
  REMOVED
}

enum DocumentType {
  LEASE
  GOVERNMENT_ID
  PROPERTY_PROOF
  PHOTO
  OTHER
}

// ----------------------------------------------------------------------------
// Users
// ----------------------------------------------------------------------------

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  passwordHash     String
  role             Role
  status           UserStatus @default(ACTIVE)
  verified         Boolean    @default(false) // tenant info verification (SRS §4.1)
  reviewsSuspended Boolean    @default(false) // review privileges suspended (SRS §4.1)

  fullName         String
  phone            String?
  governmentId     String?
  emergencyContact String?
  avatarUrl        String?    @db.Text
  username         String?    @unique // unique handle shown across the app
  currency         String?    @default("INR") // display currency preference (ISO code)
  prefCountry      String?    // location preference: country
  prefState        String?    // location preference: province/state
  prefCity         String?    // location preference: city
  lastSeenAt           DateTime? // presence heartbeat for chat "online" status
  chatContactConfirmed Boolean   @default(false) // tenant confirmed name/email/phone before chatting

  // Delegated onboarding: a tenant is managed/approved by a landlord.
  landlordId       String?
  landlord         User?      @relation("ManagedTenants", fields: [landlordId], references: [id])
  managedTenants   User[]     @relation("ManagedTenants")

  // Relations as landlord
  ownedProperties  Property[]            @relation("LandlordProperties")
  landlordLeases   Lease[]               @relation("LandlordLeases")

  // Relations as tenant
  tenantLeases     Lease[]               @relation("TenantLeases")
  payments         Payment[]
  maintenance      MaintenanceRequest[]  @relation("TenantMaintenance")
  complaints       Complaint[]           @relation("TenantComplaints")

  // Ratings given / received
  ratingsGiven     Rating[]   @relation("RatingsGiven")
  ratingsReceived  Rating[]   @relation("RatingsReceived")

  documents        Document[]
  notifications    Notification[]
  pushSubs         PushSubscription[]
  auditLogs        AuditLog[]
  complaintMsgs    ComplaintMessage[]
  resetTokens      PasswordResetToken[]
  sentMessages     Message[]            @relation("SentMessages")
  receivedMessages Message[]            @relation("ReceivedMessages")
  inquiries        PropertyInquiry[]    @relation("UserInquiries")
  marketplaceListings  MarketplaceListing[]  @relation("MarketplaceListings")
  marketplaceFavorites MarketplaceFavorite[] @relation("MarketplaceFavorites")

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([role])
  @@index([status])
  @@index([landlordId])
}

// ----------------------------------------------------------------------------
// Properties & Units
// ----------------------------------------------------------------------------

enum FurnishingStatus {
  UNFURNISHED
  SEMI_FURNISHED
  FURNISHED
}

enum ListedBy {
  OWNER
  DEALER
  BUILDER
}

model Property {
  id               String             @id @default(cuid())
  ref              String?            @unique // public 6-digit reference code (e.g. 204517)
  landlord         User               @relation("LandlordProperties", fields: [landlordId], references: [id])
  landlordId       String

  name             String
  type             PropertyType       @default(APARTMENT)
  address          String             @db.Text
  description      String?            @db.Text
  rooms            Int?               // bedrooms
  bathrooms        Int?               // washrooms
  balconies        Int?
  floor            Int?               // which floor this unit is on
  totalFloors      Int?               // floors in the building
  areaSqft         Int?               // carpet/built-up area
  furnishing       FurnishingStatus   @default(UNFURNISHED)
  hasLobby         Boolean            @default(false)
  hasParking       Boolean            @default(false)
  hasLift          Boolean            @default(false)
  powerBackup      Boolean            @default(false)
  carpetAreaSqft     Int?
  facing             String?          // e.g. North-East
  bachelorsAllowed   Boolean          @default(true)
  maintenanceMonthly Decimal?         @db.Decimal(12, 2) // monthly society maintenance
  projectName        String?          // building / society name
  parkingSpots       Int?             // number of car parking spaces
  listedBy           ListedBy         @default(OWNER)
  rentAmount       Decimal            @db.Decimal(12, 2)
  securityDeposit  Decimal            @db.Decimal(12, 2) @default(0)
  amenities        Json               @default("[]") // string[] of amenity labels (MySQL has no array type)
  availability     AvailabilityStatus @default(AVAILABLE)
  numberOfUnits    Int                @default(1)
  noticePeriodDays Int                @default(30) // default notice-to-vacate period for this property
  verified         Boolean            @default(false) // ownership documents verified
  approved         Boolean            @default(false) // property registration approved
  listedPublic     Boolean            @default(true)  // landlord opted to show it on the public listings page

  units            Unit[]
  leases           Lease[]
  maintenance      MaintenanceRequest[]
  complaints       Complaint[]
  documents        Document[]
  applications     Application[]
  visits           Visit[]
  inquiries        PropertyInquiry[]

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([landlordId])
  @@index([availability])
}

enum VisitStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
}

// A guest (anonymous visitor) chat with a landlord about a specific property.
// Identified by a token the browser keeps, so no account is required.
model PropertyInquiry {
  id         String           @id @default(cuid())
  token      String           @unique @default(cuid())
  property   Property         @relation(fields: [propertyId], references: [id])
  propertyId String
  landlordId String // denormalised from the property for quick inbox queries
  guestName  String
  guestPhone String
  guestEmail String?
  user       User?            @relation("UserInquiries", fields: [userId], references: [id])
  userId     String? // set when a signed-in USER (not an anonymous guest) starts the chat
  messages   InquiryMessage[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([landlordId])
  @@index([propertyId])
  @@index([userId])
}

model InquiryMessage {
  id             String          @id @default(cuid())
  inquiry        PropertyInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  inquiryId      String
  fromGuest      Boolean // true = visitor, false = landlord
  body           String          @db.Text
  readByLandlord Boolean         @default(false)
  readByGuest    Boolean         @default(false)
  createdAt      DateTime        @default(now())

  @@index([inquiryId])
}

// Direct 1:1 message between a landlord and one of their tenants.
model Message {
  id          String   @id @default(cuid())
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  senderId    String
  recipient   User     @relation("ReceivedMessages", fields: [recipientId], references: [id])
  recipientId String
  body        String   @db.Text
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([senderId])
  @@index([recipientId])
  @@index([createdAt])
}

// A prospective tenant's request to tour a property.
model Visit {
  id          String      @id @default(cuid())
  property    Property    @relation(fields: [propertyId], references: [id])
  propertyId  String
  fullName    String
  email       String
  phone       String?
  preferredAt DateTime
  message     String?     @db.Text
  status      VisitStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([propertyId])
  @@index([status])
}

model Unit {
  id          String             @id @default(cuid())
  property    Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId  String
  label       String // e.g. "Unit 2B", "Room 3"
  availability AvailabilityStatus @default(AVAILABLE)
  leases      Lease[]
  maintenance MaintenanceRequest[]

  @@index([propertyId])
}

// ----------------------------------------------------------------------------
// Leases
// ----------------------------------------------------------------------------

model Lease {
  id                String      @id @default(cuid())
  property          Property    @relation(fields: [propertyId], references: [id])
  propertyId        String
  unit              Unit?       @relation(fields: [unitId], references: [id])
  unitId            String?

  landlord          User        @relation("LandlordLeases", fields: [landlordId], references: [id])
  landlordId        String
  tenant            User        @relation("TenantLeases", fields: [tenantId], references: [id])
  tenantId          String

  startDate         DateTime
  endDate           DateTime
  monthlyRent       Decimal     @db.Decimal(12, 2)
  securityDeposit   Decimal     @db.Decimal(12, 2) @default(0)
  maintenanceFee    Decimal?    @db.Decimal(12, 2) // optional monthly maintenance charge
  terms             String?     @db.Text
  signedContractUrl String?     @db.Text
  status            LeaseStatus @default(DRAFT)

  // Notice-to-vacate / terminate (either party may give notice)
  noticePeriodDays    Int          @default(30)
  noticeGivenAt       DateTime?
  noticeByParty       NoticeParty?
  noticeEffectiveDate DateTime?

  invoices          Invoice[]
  ratings           Rating[]
  documents         Document[]

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([landlordId])
  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
}

// ----------------------------------------------------------------------------
// Invoices & Payments
// ----------------------------------------------------------------------------

model Invoice {
  id          String        @id @default(cuid())
  lease       Lease         @relation(fields: [leaseId], references: [id])
  leaseId     String
  periodMonth DateTime // first day of the billed month
  amount      Decimal       @db.Decimal(12, 2)
  dueDate     DateTime
  status      InvoiceStatus @default(PENDING)
  payments    Payment[]

  // Rent-reminder milestones already sent (e.g. "T-7","T-3","DUE","OVERDUE") — prevents duplicate reminders.
  remindersSent Json        @default("[]") // string[] of milestone codes (MySQL has no array type)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([leaseId, periodMonth])
  @@index([status])
  @@index([dueDate])
}

model Payment {
  id               String        @id @default(cuid())
  invoice          Invoice       @relation(fields: [invoiceId], references: [id])
  invoiceId        String
  tenant           User          @relation(fields: [tenantId], references: [id])
  tenantId         String

  amount           Decimal       @db.Decimal(12, 2)
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  gatewayOrderId   String? // Razorpay order id
  gatewayPaymentId String? // Razorpay payment id
  receiptUrl       String?       @db.Text
  paidAt           DateTime?
  verified         Boolean       @default(false) // reconciled/verified by admin
  refundedAt       DateTime?
  notes            String?       @db.Text // reference / refund reason

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([invoiceId])
  @@index([tenantId])
  @@index([status])
}

// ----------------------------------------------------------------------------
// Maintenance
// ----------------------------------------------------------------------------

model MaintenanceRequest {
  id          String            @id @default(cuid())
  property    Property          @relation(fields: [propertyId], references: [id])
  propertyId  String
  unit        Unit?             @relation(fields: [unitId], references: [id])
  unitId      String?
  tenant      User              @relation("TenantMaintenance", fields: [tenantId], references: [id])
  tenantId    String

  title       String
  description String            @db.Text
  priority    Priority          @default(MEDIUM)
  status      MaintenanceStatus @default(PENDING)
  assignedTo  String? // technician name / contact
  images      Json              @default("[]") // string[] of image URLs (MySQL has no array type)

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([propertyId])
  @@index([tenantId])
  @@index([status])
}

// ----------------------------------------------------------------------------
// Complaints
// ----------------------------------------------------------------------------

model Complaint {
  id          String             @id @default(cuid())
  property    Property?          @relation(fields: [propertyId], references: [id])
  propertyId  String?
  tenant      User               @relation("TenantComplaints", fields: [tenantId], references: [id])
  tenantId    String

  subject     String
  description String             @db.Text
  status      ComplaintStatus    @default(OPEN)
  messages    ComplaintMessage[]

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([tenantId])
  @@index([status])
}

model ComplaintMessage {
  id          String    @id @default(cuid())
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  complaintId String
  author      User      @relation(fields: [authorId], references: [id])
  authorId    String
  body        String    @db.Text
  createdAt   DateTime  @default(now())

  @@index([complaintId])
}

// ----------------------------------------------------------------------------
// Ratings & Reviews (two-way)
// ----------------------------------------------------------------------------

model Rating {
  id          String          @id @default(cuid())
  lease       Lease           @relation(fields: [leaseId], references: [id])
  leaseId     String
  direction   RatingDirection
  rater       User            @relation("RatingsGiven", fields: [raterId], references: [id])
  raterId     String
  ratee       User            @relation("RatingsReceived", fields: [rateeId], references: [id])
  rateeId     String

  stars       Int // 1..5
  feedback    String?         @db.Text
  recommend   Boolean         @default(false)
  criteria    Json? // per-direction criteria scores
  status      RatingStatus    @default(VISIBLE)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([leaseId, direction]) // one rating per side per lease
  @@index([rateeId])
  @@index([status])
}

// ----------------------------------------------------------------------------
// Documents, Notifications, Push, Audit
// ----------------------------------------------------------------------------

model Document {
  id          String       @id @default(cuid())
  owner       User         @relation(fields: [ownerId], references: [id])
  ownerId     String
  property    Property?    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId  String?
  lease       Lease?       @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  leaseId     String?
  type        DocumentType @default(OTHER)
  // Local-storage files use storageKey; url is kept for external/legacy links.
  url         String?      @db.Text
  storageKey  String?
  fileName    String?      @db.Text
  contentType String?
  sizeBytes   Int?
  label       String?      @db.Text
  docNumber   String?      // ID/passport number (stored as entered; masked in API responses)
  expiryDate  DateTime?    // document expiry, where applicable
  verified    Boolean      @default(false) // admin-verified document
  createdAt   DateTime     @default(now())

  @@index([ownerId])
  @@index([propertyId])
  @@index([leaseId])
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  type      String
  title     String
  body      String?  @db.Text
  link      String?  @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  endpoint  String   @unique @db.VarChar(512) // push endpoints exceed the 191-char default
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// One-time email verification code (e.g. a visitor proving their email before
// they can start a chat with a property owner). Short-lived; consumed on use.
model EmailOtp {
  id         String    @id @default(cuid())
  email      String
  codeHash   String // sha-256 of the 6-digit code (never store the raw code)
  purpose    String    @default("chat") // what the code unlocks
  attempts   Int       @default(0) // wrong-code guesses, capped to stop brute force
  verified   Boolean   @default(false) // set once the correct code is entered
  verifyToken String?  @unique // issued on success; the next step presents this
  expiresAt  DateTime
  consumedAt DateTime? // set when the verifyToken is finally redeemed
  createdAt  DateTime  @default(now())

  @@index([email])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Public rental application submitted by a prospective tenant against a listing.
model Application {
  id         String            @id @default(cuid())
  property   Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  fullName   String
  email      String
  phone      String?
  message    String?           @db.Text
  status     ApplicationStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([propertyId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     User?    @relation(fields: [actorId], references: [id])
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
}

// ---- Marketplace (tenant buy/sell of household items) ----
model MarketplaceListing {
  id          String   @id @default(cuid())
  seller      User     @relation("MarketplaceListings", fields: [sellerId], references: [id])
  sellerId    String
  title       String
  description String?  @db.Text
  category    String
  condition   String   @default("GOOD") // NEW, LIKE_NEW, GOOD, FAIR
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("INR")
  location    String?
  images      Json     @default("[]") // string[] of /api/files/{id} paths (MySQL has no array type)
  status      String   @default("AVAILABLE") // AVAILABLE, SOLD
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  favorites   MarketplaceFavorite[]

  @@index([sellerId])
  @@index([category])
  @@index([status])
}

model MarketplaceFavorite {
  id        String             @id @default(cuid())
  user      User               @relation("MarketplaceFavorites", fields: [userId], references: [id])
  userId    String
  listing   MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  createdAt DateTime           @default(now())

  @@unique([userId, listingId])
  @@index([userId])
}
